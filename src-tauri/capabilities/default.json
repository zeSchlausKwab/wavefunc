{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main WaveFunc window, all platforms",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "tel:*" },
        { "url": "lightning:*" },
        { "url": "nostrconnect:*" },
        { "url": "bunker:*" }
      ]
    },
    "deep-link:default",
    "wavefunc-player:default",
    "wavefunc-media:default"
  ]
}
